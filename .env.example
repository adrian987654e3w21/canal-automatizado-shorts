# Copia este archivo como .env y sustituye los valores. Nunca subas .env a Git.

# Identidad del canal
# El RPM de los Shorts depende mucho del nicho: finanzas, B2B y herramientas de
# software pagan varias veces mas que las curiosidades o el entretenimiento, y son
# los unicos que suelen recibir patrocinios. Si no sabes por donde empezar, no
# clones el ejemplo de abajo: elija segun el CPM de los anunciantes de tu sector.
CONTENT_NICHE=herramientas de IA y automatizacion para negocios
CONTENT_LANGUAGE=es-ES
TARGET_AUDIENCE=emprendedores y petites empresas de 25 a 45 anos
TONE=directo, practico y sin humo
CONTENT_GUARDRAILS=No inventes cifras, citas ni hechos; evita engaños y clickbait. No incluyas acotaciones, emojis, URLs ni hashtags dentro del guion.

# Programacion
CRON_SCHEDULE=0 10 * * *
CRON_TIMEZONE=America/Mexico_City
RUN_ON_START=false

# OpenAI (modelo de la familia GPT-4 compatible con Structured Outputs)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
SCRIPT_MIN_WORDS=120
SCRIPT_MAX_WORDS=140
MIN_SCRIPT_SECONDS=45
MAX_SCRIPT_SECONDS=60

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.50
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.00
ELEVENLABS_SPEED=1.00
ELEVENLABS_USE_SPEAKER_BOOST=true

# Video y subtitulos
# BACKGROUND_DIR se escanea y el pipeline rota entre los clips para que el canal
# no publique siempre el mismo fondo. BACKGROUND_FILE / BACKGROUND_FILES tienen
# prioridad si se rellenan.
BACKGROUND_DIR=assets/backgrounds
BACKGROUND_FILE=
BACKGROUND_FILES=
BACKGROUND_ROTATION=true
OUTPUT_DIR=output
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=20
VIDEO_PRESET=medium
SUBTITLE_MAX_CHARACTERS=40
SUBTITLE_MAX_DURATION_SECONDS=3.2
SUBTITLE_MAX_WORDS=8
SUBTITLE_FONT=Arial
# Tamano en pixeles reales: el ASS declara PlayResX/PlayResY = VIDEO_WIDTH/HEIGHT.
SUBTITLE_FONT_SIZE=84
SUBTITLE_COLOR=#FFFFFF
SUBTITLE_HIGHLIGHT_COLOR=#FFD400
SUBTITLE_OUTLINE_COLOR=#000000
SUBTITLE_OUTLINE=5
SUBTITLE_SHADOW=2
SUBTITLE_BOLD=true
SUBTITLE_KARAOKE=true
# Anclaje ASS: 1=abajo centro, 2=abajo izquierda, 5=centro, 8=arriba centro.
SUBTITLE_ALIGNMENT=2
SUBTITLE_MARGIN_L=90
SUBTITLE_MARGIN_R=90
SUBTITLE_MARGIN_V=300
# Las fuentes se resuelven con las del sistema (Arial, Verdana, ...). No hay
# carpeta de fuentes configurable: romperia el filtergraph de ffmpeg.

# Opcional: rutas absolutas de binarios del sistema. Si se omiten,
# se usan las versiones incluidas por ffmpeg-static y ffprobe-static.
FFMPEG_PATH=
FFPROBE_PATH=

# Publicacion. DRY_RUN=true genera el MP4 pero no lo sube.
DRY_RUN=true
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2/callback

# Alternativa temporal (el token de acceso caduca; no es ideal para produccion).
YOUTUBE_ACCESS_TOKEN=

# Opciones del video publicado
YOUTUBE_PRIVACY=unlisted
YOUTUBE_CATEGORY_ID=27
YOUTUBE_DEFAULT_TAGS=shorts,curiosidades,espacio
YOUTUBE_DESCRIPTION_FOOTER=Contenido generado con asistencia de inteligencia artificial.
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_EMBEDDABLE=true
YOUTUBE_PLAYLIST_ID=

# ============================================================
# TIKTOK — mismo MP4, segunda fuente de ingresos
# ============================================================
# Requiere registrar la app en TikTok for Developers y aprobar la
# "Content Posting API". Hasta obtener la aprobacion, dejalo en false.
TIKTOK_ENABLED=false
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_DESCRIPTION_FOOTER=

# ============================================================
# INSTAGRAM REELS — tercera fuente de ingresos
# ============================================================
# Dos requisitos que no son opcionales:
#  1. La cuenta de Instagram debe ser Business o Creator y estar vinculada a
#     una Fan Page de Facebook.
#  2. IG_REELS_URL_BASE debe ser una URL publica desde la que Instagram pueda
#     descargar el MP4 (tunel, NAS publico o bucket en la nube). Un archivo en
#     local no sirve: la API no lee tu disco.
INSTAGRAM_ENABLED=false
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
IG_REELS_URL_BASE=
IG_REELS_SLUG=short
IG_GRAPH_VERSION=21.0
IG_SHARE_TO_FEED=true
IG_DESCRIPTION_FOOTER=

# Anti-repeticion: alimenta el historial que se inyecta en el prompt.
HISTORY_FILE=history.json
HISTORY_MAX_ENTRIES=120

# ============================================================
# MODO 100 % GRATIS (Ollama + Piper) — alternativa a OpenAI/ElevenLabs
# ============================================================
# Activar para usar modelos locales en lugar de APIs de pago.
# Requiere: Ollama corriendo + modelo descargado + Piper instalado + modelo de voz .onnx
USE_LOCAL_AI=false

# Ollama (LLM local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=1800

# Piper TTS (voz local)
# Descarga modelos .onnx + .onnx.json desde:
# https://huggingface.co/rhasspy/piper-voices/tree/main
# Ejemplo voz ES: es_ES-sharvard-medium.onnx
PIPER_BINARY=piper
PIPER_MODEL=assets/voices/es_ES-sharvard-medium.onnx
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8
PIPER_SAMPLE_RATE=22050
