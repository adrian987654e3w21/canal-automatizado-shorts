# Copia este archivo como .env y sustituye los valores. Nunca subas .env a Git.

# Identidad del canal
CONTENT_NICHE=curiosidades del espacio
CONTENT_LANGUAGE=es-ES
TARGET_AUDIENCE=adultos curiosos de 18 a 34 anos
TONE=curioso, claro, energetico y creible
CONTENT_GUARDRAILS=No inventes cifras, citas ni hechos; evita engaños y clickbait. No incluyas acotaciones, emojis, URLs ni hashtags dentro del guion.

# Programacion
CRON_SCHEDULE=0 10 * * *
CRON_TIMEZONE=America/Mexico_City
RUN_ON_START=false

# OpenAI (modelo de la familia GPT-4 compatible con Structured Outputs)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
SCRIPT_MIN_WORDS=120
SCRIPT_MAX_WORDS=140
MIN_SCRIPT_SECONDS=45
MAX_SCRIPT_SECONDS=60

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.50
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.00
ELEVENLABS_SPEED=1.00
ELEVENLABS_USE_SPEAKER_BOOST=true

# Video y subtitulos
BACKGROUND_FILE=assets/backgrounds/default.mp4
OUTPUT_DIR=output
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=20
VIDEO_PRESET=medium
SUBTITLE_MAX_CHARACTERS=40
SUBTITLE_MAX_DURATION_SECONDS=3.2
SUBTITLE_MAX_WORDS=8
SUBTITLE_FONT=Arial
SUBTITLE_FONT_SIZE=18
SUBTITLE_OUTLINE=4
SUBTITLE_MARGIN_V=220

# Opcional: rutas absolutas de binarios del sistema. Si se omiten,
# se usan las versiones incluidas por ffmpeg-static y ffprobe-static.
FFMPEG_PATH=
FFPROBE_PATH=

# Publicacion. DRY_RUN=true genera el MP4 pero no lo sube.
DRY_RUN=true
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2/callback

# Alternativa temporal (el token de acceso caduca; no es ideal para produccion).
YOUTUBE_ACCESS_TOKEN=

# Opciones del video publicado
YOUTUBE_PRIVACY=unlisted
YOUTUBE_CATEGORY_ID=27
YOUTUBE_DEFAULT_TAGS=shorts,curiosidades,espacio
YOUTUBE_DESCRIPTION_FOOTER=Contenido generado con asistencia de inteligencia artificial.
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_EMBEDDABLE=true
YOUTUBE_PLAYLIST_ID=

# ============================================================
# MODO 100 % GRATIS (Ollama + Piper) — alternativa a OpenAI/ElevenLabs
# ============================================================
# Activar para usar modelos locales en lugar de APIs de pago.
# Requiere: Ollama corriendo + modelo descargado + Piper instalado + modelo de voz .onnx
USE_LOCAL_AI=false

# Ollama (LLM local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=1800

# Piper TTS (voz local)
# Descarga modelos .onnx + .onnx.json desde:
# https://huggingface.co/rhasspy/piper-voices/tree/main
# Ejemplo voz ES: es_ES-sharvard-medium.onnx
PIPER_BINARY=piper
PIPER_MODEL=assets/voices/es_ES-sharvard-medium.onnx
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8
PIPER_SAMPLE_RATE=22050
