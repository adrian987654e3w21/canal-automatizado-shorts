{
  "name": "faceless-shorts-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend autónomo para generar, narrar, renderizar y publicar Shorts verticales.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "generate-now": "node index.js --now",
    "youtube:auth": "node scripts/get-youtube-token.js",
    "background:demo": "node scripts/create-demo-background.js",
    "test": "node --test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "deploy": "bash deploy.sh",
    "deploy:ps": "powershell -ExecutionPolicy Bypass -File deploy.ps1"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^182.0.0",
    "node-cron": "^4.6.0",
    "openai": "^7.23.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
